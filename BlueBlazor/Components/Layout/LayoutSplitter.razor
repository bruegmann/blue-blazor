@using Microsoft.Extensions.Localization
@namespace BlueBlazor.Components
@inherits BlueComponentBase
@inject IStringLocalizer<BlueBlazor.Resources.Phrases> L

<sp-split-view class="@ClassValue" style="@Style" @attributes="AdditionalAttributes">
    <div>
        <div class="@(new CssBuilder("blue-layout-body").AddClass("border-0", NoPageBorder).Build())">@Start</div>
    </div>

    <div>
        <dialog class="blue-layout-inspector blue-lg-modal blue-modal modal"
                id="@INSPECTOR_ID"
                aria-labelledby="@INSPECTOR_LABEL_ID">
            <div class="offcanvas offcanvas-end">
                <div class="offcanvas-header">
                    <h1 class="h5 offcanvas-title" id="@INSPECTOR_LABEL_ID">
                        @if (DrawerTitle == null && DrawerTitleContent == null)
                        {
                            @L["Inspector"]
                        }
                        else
                        {
                            @DrawerTitle
                            @DrawerTitleContent
                        }
                    </h1>
                    <form method="dialog" style="display: contents;">
                        <button type="submit" class="btn-close" aria-label="@(L["Close"])"></button>
                    </form>
                </div>
                <div class="@(new CssBuilder("offcanvas-body").AddClass(DrawerBodyClass).Build())">
                    <div class="blue-layout-inspector-body">@End</div>
                </div>
            </div>
            <form method="dialog" class="blue-modal-backdrop"><button>@L["Close"]</button></form>
        </dialog>
    </div>
</sp-split-view>